# Copy to .env and fill in. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models. Check your project's free-tier limits in AI Studio; they change often.
# Flash-Lite usually has a much higher free daily quota than Flash, so it is the default
# for development and for the eval judge. Switch GEN_MODEL to Flash for final runs.
GEN_MODEL=gemini-3.5-flash-lite
# The judge should not be the model it grades. "groq:<model>" sends judge calls to Groq's free
# tier (key from https://console.groq.com/keys), which also keeps them off the Gemini daily quota.
JUDGE_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MAX_RPM=3

# Client-side throttle, kept under the free-tier per-minute limit (15 RPM for 3.5 Flash-Lite;
# its daily limit is 500 requests, reset at midnight Pacific = 13:30 IST).
LLM_MAX_RPM=12

# Local embedding model (runs on CPU, ~130 MB).
EMBED_MODEL=BAAI/bge-small-en-v1.5

# LangSmith (free Developer plan). Used from week 2.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=policy-rag
